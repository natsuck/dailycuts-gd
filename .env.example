APP_NAME="The Daily Cuts"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
MAYA_MODE=sandbox
# Maya webhooks are not signed and only accepted from these IPs. Leave unset to
# use the per-mode default (sandbox 13.229.160.234,3.1.199.75 / production
# 18.138.50.235,3.1.207.200). Do NOT set sandbox IPs when running production.
MAYA_WEBHOOK_IPS=
# Overrides the Maya API base URL per mode. Production defaults to
# https://pg.paymaya.com (the Environments page lists https://pg.maya.ph).
# MAYA_BASE_URL=
# Retries for the Maya Create Checkout call on transient failures (429/5xx/network).
MAYA_CHECKOUT_RETRIES=3
MAYA_CHECKOUT_RETRY_DELAY_MS=500

# Reverse proxies in front of the app (comma-separated IPs or CIDR ranges).
# Defaults to loopback only, matching the documented nginx + PHP-FPM same-box
# setup. Deployment-critical: behind an external load balancer / CDN the app
# would otherwise see the proxy's IP and REJECT every legitimate Maya webhook.
# Example for Cloudflare: TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22
TRUSTED_PROXIES=

SHOP_FLAT_SHIPPING_FEE=0
RESELLER_INQUIRY_EMAIL=

SHOP_NAME="The Daily Cuts"
SHOP_BRANCH_PHONE=+639000000000

LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_MARKET=PH
LALAMOVE_SANDBOX=true
LALAMOVE_SERVICE_TYPE=MOTORCYCLE
LALAMOVE_WEBHOOK_URL=
# Lalamove signs webhooks with HMAC-SHA256 over the raw body + webhook URL path,
# keyed by LALAMOVE_API_SECRET. See LalamoveWebhookController::verifyPayload.
LALAMOVE_SPECIAL_REQUESTS=THERMAL_BAG_1
LALAMOVE_ITEM_WEIGHT=LESS_THAN_20_KG
LALAMOVE_ITEM_CATEGORIES=FOOD_AND_BEVERAGES
LALAMOVE_ITEM_HANDLING=KEEP_DRY

GOOGLE_MAPS_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://thedailycuts.com/auth/google/callback

GEOCODER_PROVIDERS=google,photon,nominatim
PHOTON_GEOCODING_URL=https://photon.komoot.io/api
NOMINATIM_GEOCODING_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=TheDailyCutsByGD/1.0

VITE_APP_NAME="${APP_NAME}"
